+def development_result_path(cfg, args):
+    """Reject final-test access and absent assets before initializing CUDA."""
+    if args.eval_set != '3dpw' or args.eval_split != 'val':
+        raise ValueError('This development entry requires --eval-set 3dpw --eval-split val')
+    if not args.metrics_output_dir or not Path(args.metrics_output_dir).is_absolute():
+        raise ValueError('An absolute --metrics-output-dir is required')
+    checkpoint = Path(cfg.TRAIN.CHECKPOINT)
+    if not checkpoint.is_file():
+        raise FileNotFoundError(f'Missing selected checkpoint: {checkpoint}')
+    cache = Path(_C.PATHS.PARSED_DATA) / f'3dpw_val_{cfg.MODEL.BACKBONE}.pth'
+    if not cache.is_file():
+        raise FileNotFoundError(f'Missing validation cache: {cache}')
+    output_dir = Path(args.metrics_output_dir)
+    output_dir.mkdir(parents=True, exist_ok=True)
+    result_path = output_dir / 'wham_3dpw_validation.json'
+    if result_path.exists():
+        raise FileExistsError(f'Refusing to overwrite development evidence: {result_path}')
+    return result_path
